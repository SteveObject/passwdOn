{
  "manifest_version": 3,
  "name": "passwdOn",
  "version": "0.1.0",
  "minimum_chrome_version": "106",
  "description": "按完整站点管理账号，在登录页快捷填充。",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "passwdOn · 快捷填充",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_ui": { "page": "manager.html", "open_in_tab": true },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "打开 passwdOn 快捷填充"
    }
  }
}
